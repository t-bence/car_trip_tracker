{
  "datasets": [
    {
      "name": "ds_trips",
      "displayName": "Trips",
      "queryLines": [
        "SELECT\n",
        "  start_event_id,\n",
        "  start_time,\n",
        "  end_time,\n",
        "  duration_minutes,\n",
        "  CASE\n",
        "    WHEN duration_minutes < 5 THEN '<5'\n",
        "    WHEN duration_minutes < 10 THEN '5-10'\n",
        "    WHEN duration_minutes < 20 THEN '10-20'\n",
        "    WHEN duration_minutes < 30 THEN '20-30'\n",
        "    WHEN duration_minutes < 45 THEN '30-45'\n",
        "    WHEN duration_minutes < 60 THEN '45-60'\n",
        "    ELSE '60+'\n",
        "  END AS duration_bucket,\n",
        "  CASE WHEN duration_minutes < 20 THEN 1 ELSE 0 END AS is_short_trip,\n",
        "  CASE WHEN duration_minutes >= 20 THEN 'Long drive' ELSE 'Short trip' END AS trip_kind,\n",
        "  ST_MAKELINE(ARRAY(\n",
        "    ST_POINT(start_longitude, start_latitude, 4326),\n",
        "    ST_POINT(end_longitude, end_latitude, 4326)\n",
        "  )) AS trip_line\n",
        "FROM silver_trips\n"
      ]
    },
    {
      "name": "ds_long_drive_gaps",
      "displayName": "Gaps between long drives",
      "queryLines": [
        "WITH bounds AS (\n",
        "  SELECT\n",
        "    to_timestamp(greatest(:date_range.min, MIN(to_date(start_time)))) AS range_from,\n",
        "    to_timestamp(least(:date_range.max, MAX(to_date(start_time)))) + make_dt_interval(0, 23, 59, 59) AS range_to\n",
        "  FROM silver_trips\n",
        "),\n",
        "drives AS (\n",
        "  SELECT start_time\n",
        "  FROM silver_trips, bounds\n",
        "  WHERE duration_minutes >= 20 AND start_time BETWEEN range_from AND range_to\n",
        "),\n",
        "marks AS (\n",
        "  SELECT range_from AS mark_time FROM bounds\n",
        "  UNION ALL SELECT start_time FROM drives\n",
        "  UNION ALL SELECT range_to FROM bounds\n",
        "),\n",
        "gaps AS (\n",
        "  SELECT (unix_timestamp(mark_time) - unix_timestamp(LAG(mark_time) OVER (ORDER BY mark_time))) / 86400.0 AS gap_days\n",
        "  FROM marks\n",
        ")\n",
        "SELECT\n",
        "  (SELECT COUNT(*) FROM drives) AS long_drive_count,\n",
        "  MAX(gap_days) AS longest_gap_days,\n",
        "  (SELECT (unix_timestamp(range_to) - unix_timestamp(range_from)) / 86400.0\n",
        "     / greatest((SELECT COUNT(*) FROM drives), 1) FROM bounds) AS avg_gap_days\n",
        "FROM gaps\n"
      ],
      "parameters": [
        {
          "displayName": "date_range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "2025-01-01T00:00:00.000"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "ds_status",
      "displayName": "Last trip",
      "queryLines": [
        "SELECT date_format(MAX(end_time), 'yyyy-MM-dd HH:mm') AS last_trip_ended\n",
        "FROM silver_trips\n"
      ]
    }
  ],
