{
  "datasets": [
    {
      "name": "ds_trips",
      "displayName": "Trips",
      "queryLines": [
        "SELECT\n",
        "  start_event_id,\n",
        "  start_time,\n",
        "  end_time,\n",
        "  duration_minutes,\n",
        "  CASE\n",
        "    WHEN duration_minutes < 5 THEN '<5'\n",
        "    WHEN duration_minutes < 10 THEN '5-10'\n",
        "    WHEN duration_minutes < 25 THEN '10-25'\n",
        "    WHEN duration_minutes < 45 THEN '25-45'\n",
        "    WHEN duration_minutes < 60 THEN '45-60'\n",
        "    ELSE '60+'\n",
        "  END AS duration_bucket,\n",
        "  CASE WHEN is_long_drive THEN 'Long drive' ELSE 'Short trip' END AS trip_kind,\n",
        "  ST_MAKELINE(ARRAY(\n",
        "    ST_POINT(start_longitude, start_latitude, 4326),\n",
        "    ST_POINT(end_longitude, end_latitude, 4326)\n",
        "  )) AS trip_line\n",
        "FROM gold_trip_engine_profile\n"
      ]
    },
    {
      "name": "ds_weekly",
      "displayName": "Weeks",
      "queryLines": [
        "SELECT week_start, cold_start_count, cold_short_trip_count, long_drive_count\n",
        "FROM gold_trip_engine_weekly\n"
      ]
    },
    {
      "name": "ds_verdict",
      "displayName": "Diesel verdict",
      "queryLines": [
        "WITH weeks AS (\n",
        "  SELECT *\n",
        "  FROM gold_trip_engine_weekly\n",
        "  WHERE week_start BETWEEN to_date(date_trunc('WEEK', :date_range.min)) AND :date_range.max\n",
        "),\n",
        "totals AS (\n",
        "  SELECT\n",
        "    SUM(days_covered) / 7.0 AS weeks_tracked,\n",
        "    SUM(trip_count) AS trip_count,\n",
        "    SUM(cold_short_trip_count) AS cold_short_trip_count,\n",
        "    SUM(warm_minutes) / NULLIF(SUM(driving_minutes), 0) AS warm_share,\n",
        "    -- Only complete weeks with driving: a week without trips builds up no soot.\n",
        "    SUM(CASE WHEN is_complete_week AND trip_count > 0 AND long_drive_count > 0 THEN 1 ELSE 0 END)\n",
        "      / NULLIF(SUM(CASE WHEN is_complete_week AND trip_count > 0 THEN 1 ELSE 0 END), 0) AS long_drive_week_share\n",
        "  FROM weeks\n",
        "),\n",
        "rated AS (\n",
        "  SELECT\n",
        "    *,\n",
        "    cold_short_trip_count / NULLIF(trip_count, 0) AS cold_short_share,\n",
        "    cold_short_trip_count / NULLIF(weeks_tracked, 0) AS cold_short_per_week\n",
        "  FROM totals\n",
        "),\n",
        "statuses AS (\n",
        "  SELECT\n",
        "    *,\n",
        "    CASE WHEN long_drive_week_share IS NULL THEN 'none' WHEN long_drive_week_share < 0.6 THEN 'red' WHEN long_drive_week_share >= 0.9 THEN 'green' ELSE 'yellow' END AS long_drive_status,\n",
        "    CASE WHEN cold_short_share IS NULL THEN 'none' WHEN cold_short_share > 0.4 OR cold_short_per_week > 5 THEN 'red' WHEN cold_short_share < 0.2 AND cold_short_per_week <= 2 THEN 'green' ELSE 'yellow' END AS cold_short_status,\n",
        "    CASE WHEN warm_share IS NULL THEN 'none' WHEN warm_share < 0.5 THEN 'red' WHEN warm_share > 0.7 THEN 'green' ELSE 'yellow' END AS warm_status\n",
        "  FROM rated\n",
        ")\n",
        "SELECT\n",
        "  CASE\n",
        "    WHEN array_contains(array(long_drive_status, cold_short_status, warm_status), 'red') THEN '🔴 Not a good fit for a diesel'\n",
        "    WHEN array_contains(array(long_drive_status, cold_short_status, warm_status), 'none') THEN '⚪ Not enough data yet'\n",
        "    WHEN array_contains(array(long_drive_status, cold_short_status, warm_status), 'yellow') THEN '🟡 Borderline for a diesel'\n",
        "    ELSE '🟢 Suits a diesel'\n",
        "  END AS verdict,\n",
        "  concat(CASE long_drive_status WHEN 'green' THEN '🟢' WHEN 'yellow' THEN '🟡' WHEN 'red' THEN '🔴' ELSE '⚪' END, ' ',\n",
        "    coalesce(concat(format_number(long_drive_week_share * 100, 0), '%'), 'no complete week yet')) AS long_drive_weeks_text,\n",
        "  concat(CASE cold_short_status WHEN 'green' THEN '🟢' WHEN 'yellow' THEN '🟡' WHEN 'red' THEN '🔴' ELSE '⚪' END, ' ',\n",
        "    coalesce(concat(concat(format_number(cold_short_share * 100, 0), '%'), ' · ',\n",
        "      format_number(cold_short_per_week, 1), ' / week'), 'no trips')) AS cold_short_text,\n",
        "  concat(CASE warm_status WHEN 'green' THEN '🟢' WHEN 'yellow' THEN '🟡' WHEN 'red' THEN '🔴' ELSE '⚪' END, ' ', coalesce(concat(format_number(warm_share * 100, 0), '%'), 'no trips')) AS warm_text\n",
        "FROM statuses\n"
      ],
      "parameters": [
        {
          "displayName": "date_range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "2025-01-01T00:00:00.000"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "ds_engine_metrics",
      "displayName": "Engine conditions",
      "queryLines": [
        "WITH weeks AS (\n",
        "  SELECT *\n",
        "  FROM gold_trip_engine_weekly\n",
        "  WHERE week_start BETWEEN to_date(date_trunc('WEEK', :date_range.min)) AND :date_range.max\n",
        "),\n",
        "totals AS (\n",
        "  SELECT\n",
        "    SUM(days_covered) / 7.0 AS weeks_tracked,\n",
        "    SUM(trip_count) AS trip_count,\n",
        "    SUM(cold_start_count) AS cold_starts,\n",
        "    SUM(cold_short_trip_count) AS cold_short_trips,\n",
        "    SUM(possibly_interrupted_regen_count) AS interrupted_regens,\n",
        "    SUM(long_drive_count) AS long_drives\n",
        "  FROM weeks\n",
        ")\n",
        "SELECT\n",
        "  sort_order,\n",
        "  metric,\n",
        "  in_total / NULLIF(weeks_tracked, 0) AS per_week,\n",
        "  in_total / NULLIF(trip_count, 0) AS share_of_trips,\n",
        "  in_total\n",
        "FROM totals\n",
        "LATERAL VIEW stack(\n",
        "  4,\n",
        "  1, 'Cold starts', cold_starts,\n",
        "  2, 'Cold short trips', cold_short_trips,\n",
        "  3, 'Possibly interrupted regenerations', interrupted_regens,\n",
        "  4, 'Long drives (25+ min)', long_drives\n",
        ") metrics AS sort_order, metric, in_total\n",
        "ORDER BY sort_order\n"
      ],
      "parameters": [
        {
          "displayName": "date_range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "2025-01-01T00:00:00.000"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "ds_long_drive_gaps",
      "displayName": "Gaps between long drives",
      "queryLines": [
        "WITH bounds AS (\n",
        "  SELECT\n",
        "    to_timestamp(greatest(:date_range.min, MIN(to_date(start_time)))) AS range_from,\n",
        "    to_timestamp(least(:date_range.max, MAX(to_date(start_time)))) + make_dt_interval(0, 23, 59, 59) AS range_to\n",
        "  FROM gold_trip_engine_profile\n",
        "),\n",
        "drives AS (\n",
        "  SELECT start_time\n",
        "  FROM gold_trip_engine_profile, bounds\n",
        "  WHERE is_long_drive AND start_time BETWEEN range_from AND range_to\n",
        "),\n",
        "marks AS (\n",
        "  SELECT range_from AS mark_time FROM bounds\n",
        "  UNION ALL SELECT start_time FROM drives\n",
        "  UNION ALL SELECT range_to FROM bounds\n",
        "),\n",
        "gaps AS (\n",
        "  SELECT (unix_timestamp(mark_time) - unix_timestamp(LAG(mark_time) OVER (ORDER BY mark_time))) / 86400.0 AS gap_days\n",
        "  FROM marks\n",
        ")\n",
        "SELECT\n",
        "  MAX(gap_days) AS longest_gap_days,\n",
        "  (SELECT (unix_timestamp(range_to) - unix_timestamp(range_from)) / 86400.0\n",
        "     / greatest((SELECT COUNT(*) FROM drives), 1) FROM bounds) AS avg_gap_days\n",
        "FROM gaps\n"
      ],
      "parameters": [
        {
          "displayName": "date_range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "2025-01-01T00:00:00.000"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        }
      ]
    },
    {
      "name": "ds_status",
      "displayName": "Last trip",
      "queryLines": [
        "SELECT\n",
        "  date_format(MAX(end_time), 'yyyy-MM-dd HH:mm') AS last_trip_ended,\n",
        "  coalesce(\n",
        "    concat(format_number(\n",
        "      (unix_timestamp(current_timestamp()) - unix_timestamp(MAX(CASE WHEN is_long_drive THEN end_time END)))\n",
        "        / 86400.0, 1), ' days'),\n",
        "    'No long drive yet'\n",
        "  ) AS days_since_long_drive\n",
        "FROM gold_trip_engine_profile\n"
      ]
    }
  ],
